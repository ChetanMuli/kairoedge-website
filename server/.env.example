# ===================================================
# KairoEdge Technologies - Backend Server Environment Config
# (Place this inside the `server/` directory as `.env`)
# ===================================================

# Server Port (Default: 4001)
PORT=4001

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kairoedge

# Super Admin Control Room Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
